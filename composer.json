{
    "name"             : "alledia/allediaframework",
    "description"      : "Joomlashack Framework",
    "minimum-stability": "stable",
    "license"          : "GPL-2.0-or-later",
    "type"             : "joomla-library",
    "extra"            : {
        "element"        : "lib_allediaframework",
        "element-short"  : "allediaframework",
        "name"           : "Joomlashack Framework",
        "client"         : "site",
        "target-platform": ".*",
        "package-license": "free",
        "infourl"        : "https://github.com/joomlashack/AllediaFramework/releases"
    },
    "authors"          : [
        {
            "name" : "Joomlashack",
            "email": "help@joomlashack.com"
        }
    ],
    "config"           : {
        "vendor-dir": "src/vendor"
    },
    "require"          : {
        "php"          : ">=7.4",
        "ext-curl"     : "*",
        "ext-json"     : "*",
        "ext-mbstring" : "*",
        "ext-simplexml": "*",
        "pimple/pimple": "^3.0"
    },
    "replace"          : {
        "psr/container": "*"
    },
    "scripts"          : {
        "test": [
            "@composer --working-dir=tests install --no-interaction --quiet",
            "@php tests/vendor/codeception/codeception/codecept run"
        ],
        "lint": [
            "@composer --working-dir=tests install --no-interaction --quiet",
            "@php tests/vendor/squizlabs/php_codesniffer/bin/phpcs --standard=PSR12 --extensions=php -sp --ignore='src/vendor/*,tests/vendor/*,tests/_output/*,tests/Support/_generated/*' src tests"
        ],
        "lint:fix": [
            "@composer --working-dir=tests install --no-interaction --quiet",
            "@php tests/vendor/squizlabs/php_codesniffer/bin/phpcbf --standard=PSR12 --extensions=php --ignore='src/vendor/*,tests/vendor/*,tests/_output/*,tests/Support/_generated/*' src tests"
        ]
    },
    "scripts-descriptions": {
        "test": "Install test dependencies into tests/vendor and run the Codeception suite",
        "lint": "Check src and tests against the PSR-12 coding standard",
        "lint:fix": "Automatically fix PSR-12 violations that phpcbf can correct"
    }
}
